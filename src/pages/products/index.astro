---
import { getCollection } from 'astro:content';
const products = await getCollection('products');
---
<section class="mx-auto grid max-w-6xl gap-6 p-6 sm:grid-cols-2 lg:grid-cols-3">
  {products.map((p) => (
    <a href={`/products/${p.id}`} class="rounded-lg border p-4 hover:shadow">
      <img src={p.data.image} alt={p.data.title} class="aspect-square w-full object-cover" loading="lazy" />
      <h2 class="mt-3 font-semibold">{p.data.title}</h2>
      <p class="text-sm text-gray-500">{p.data.category}</p>
    </a>
  ))}
</section>